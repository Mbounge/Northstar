[Unit]
Description=Stage captured Android apps for isolated Northstar previews
After=northstar-capture.service

[Service]
Type=oneshot
User=northstar
Group=northstar
WorkingDirectory=/opt/northstar/preview-lab
EnvironmentFile=/etc/northstar/capture.env
ExecStart=/usr/bin/python3 /opt/northstar/preview-lab/scan_capture_previews.py
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/northstar/preview-lab /srv/northstar-preview

