[Unit]
Description=Northstar isolated live app preview gateway
BindsTo=northstar-preview-emulator.service
After=northstar-preview-emulator.service
PartOf=northstar-preview-emulator.service

[Service]
Type=simple
User=northstar
Group=northstar
WorkingDirectory=/opt/northstar/preview-lab
StateDirectory=northstar-preview
StateDirectoryMode=0700
ExecStart=/opt/northstar/preview-lab/start-gateway.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadOnlyPaths=/opt/northstar/.android/avd/running

[Install]
WantedBy=multi-user.target
