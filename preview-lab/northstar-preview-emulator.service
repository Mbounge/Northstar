[Unit]
Description=Northstar standalone Wikipedia preview emulator
After=network-online.target
Wants=network-online.target
Upholds=northstar-preview-gateway.service

[Service]
Type=simple
User=northstar
Group=northstar
SupplementaryGroups=kvm
WorkingDirectory=/opt/northstar
Environment=ANDROID_HOME=/opt/android-sdk
Environment=ANDROID_SDK_ROOT=/opt/android-sdk
ExecStart=/opt/android-sdk/emulator/emulator -avd Northstar_Capture_4 -no-window -no-audio -no-boot-anim -gpu lavapipe -feature -Vulkan -accel on -port 5560 -no-snapshot-load -wipe-data -grpc 8554 -grpc-use-token -grpc-allowlist /opt/northstar/preview-lab/emulator_access.json
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=45
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/northstar/.android /opt/android-sdk

[Install]
WantedBy=multi-user.target
