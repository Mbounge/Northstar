[Unit]
Description=Northstar second isolated app preview gateway
BindsTo=northstar-preview-emulator-2.service
After=northstar-preview-emulator-2.service
PartOf=northstar-preview-emulator-2.service

[Service]
Type=simple
User=northstar
Group=northstar
WorkingDirectory=/opt/northstar/preview-lab
Environment=PREVIEW_EMULATOR_SERVICE=northstar-preview-emulator-2.service
Environment=PREVIEW_DEVICE=emulator-5562
Environment=PREVIEW_PACKAGE=de.danoeh.antennapod
Environment=PREVIEW_APP_NAME=AntennaPod
Environment=PREVIEW_ALLOWED_PACKAGES=de.danoeh.antennapod,org.wikipedia
Environment=PREVIEW_PORT=18081
Environment=PREVIEW_STATE_DIR=/var/lib/northstar-preview-2
StateDirectory=northstar-preview-2
StateDirectoryMode=0700
ExecStart=/opt/northstar/preview-lab/start-gateway.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadOnlyPaths=/opt/northstar/.android/avd/running

[Install]
WantedBy=multi-user.target
