--- /dev/null
+++ b/tests/northstar-research-evidence-continuity-prompt-contract.test.ts
@@ -0,0 +1,41 @@
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import path from "node:path";
+import test from "node:test";
+
+const root = process.cwd();
+const route = fs.readFileSync(path.join(root, "app/api/canvas-ai/route.ts"), "utf8");
+const authorship = fs.readFileSync(
+  path.join(root, "lib/canvas-ai/northstar-emergent-creative-authorship.ts"),
+  "utf8",
+);
+const designSystem = fs.readFileSync(
+  path.join(root, "lib/canvas-ai/northstar-design-system.ts"),
+  "utf8",
+);
+
+test("the blueprint critic never treats the complete research record as excess evidence", () => {
+  assert.doesNotMatch(route, /- too much evidence is shown;/);
+  assert.match(route, /complete ordered research\/evidence record is never itself “too much evidence”/i);
+  assert.match(route, /every original screen must remain complete, inspectable, and traceable/i);
+});
+
+test("composition keeps canonical flows while allowing creative work in any spatial relationship", () => {
+  assert.match(route, /annotated, connected, regrouped, reframed, or proportionally rescaled in place/i);
+  assert.match(route, /above, below, beside, between, or within the research composition/i);
+  assert.match(route, /evidence-continuity floor is identical at Low, Medium, and High thinking depth/i);
+});
+
+test("creative authorship preserves evidence identities without freezing the inherited layout", () => {
+  assert.match(authorship, /design precedent rather than a frozen layout/i);
+  assert.match(authorship, /current rendered scale, spacing, grouping, framing, and card treatment as strong design continuity—not immutable geometry/i);
+  assert.match(authorship, /first design act and every later act/i);
+  assert.match(authorship, /new synthesis below the research section is one option, not a requirement/i);
+  assert.match(authorship, /never through deletion, hiding, cropping, masking, or substitution by a derived copy/i);
+});
+
+test("component guidance makes representative evidence additive rather than substitutive", () => {
+  assert.doesNotMatch(designSystem, /show representative hero moments and attach the full sequence to the evidence layer/i);
+  assert.match(designSystem, /additive representative hero copies, annotations, or detail views/i);
+  assert.match(designSystem, /never replace the sequence with the subset/i);
+});
