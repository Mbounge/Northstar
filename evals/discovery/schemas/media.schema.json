{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "enum": [
              "image",
              "gif",
              "video"
            ]
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "sourcePage": {
            "type": "string",
            "format": "uri"
          },
          "retrievedOn": {
            "type": "string",
            "format": "date"
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "rights": {
            "type": "string",
            "minLength": 1
          },
          "durationSeconds": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "file",
          "sha256",
          "kind",
          "sourceUrl",
          "sourcePage",
          "retrievedOn",
          "scope",
          "rights"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "items"
  ],
  "description": "Candidate-visible provenance only. Curator observations belong in grader-only references."
}
