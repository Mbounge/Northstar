{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewerKind": {
      "enum": [
        "human",
        "model",
        "calibration"
      ]
    },
    "graderVersion": {
      "type": "string",
      "minLength": 1
    },
    "inputDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rubricDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "cannot-assess"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "verdict",
          "rationale",
          "observations",
          "evidenceIds"
        ]
      },
      "minItems": 1
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "cannot-assess"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "verdict",
          "rationale"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "reviewer",
    "reviewerKind",
    "graderVersion",
    "inputDigest",
    "rubricDigest",
    "criteria",
    "gates"
  ]
}
