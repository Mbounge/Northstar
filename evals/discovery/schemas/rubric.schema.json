{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "caseId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "checkpoint": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "dimension": {
            "enum": [
              "framing",
              "evidence",
              "analysis",
              "uncertainty",
              "clarity",
              "continuity",
              "canvas",
              "decision"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "minItems": 0
          },
          "acceptableAlternatives": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "checkpoint",
          "dimension",
          "required",
          "instruction",
          "evidenceIds",
          "acceptableAlternatives"
        ]
      },
      "minItems": 1
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "instruction"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "caseId",
    "criteria",
    "gates"
  ]
}
