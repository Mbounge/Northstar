{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "enum": [
        "development",
        "validation",
        "holdout"
      ]
    },
    "caseIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "caseIds"
  ]
}
