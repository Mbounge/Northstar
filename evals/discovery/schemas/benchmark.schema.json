{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "splitFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "route": {
      "const": "/canvas"
    },
    "defaultBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "maxUsd": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "maxSeconds",
        "maxUsd"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "cases",
    "splitFiles",
    "route",
    "defaultBudget"
  ]
}
