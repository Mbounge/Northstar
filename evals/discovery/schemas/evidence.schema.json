{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "sourceUrl": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "publishedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "inspected",
        "user-supplied",
        "unverified-lead"
      ]
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "supports": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "doesNotEstablish": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "quote": {
      "type": "string"
    },
    "rights": {
      "type": "string",
      "minLength": 1
    },
    "retrievedOn": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "id",
    "sourceUrl",
    "title",
    "publisher",
    "retrievedOn",
    "publishedAt",
    "status",
    "locator",
    "summary",
    "supports",
    "doesNotEstablish",
    "quote",
    "rights"
  ]
}
